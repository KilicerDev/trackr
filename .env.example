# Copy to `.env`. Read by skali (`skali dev`, `skali deploy --env-file`), docker
# compose, the vite dev server and the Go services. Everything not listed here
# has a working default; see skali.yaml for the full list.

# skali route domain and scheme (ORIGIN = APP_SCHEME://APP_DOMAIN).
# APP_SCHEME defaults to https; set it only for the local dev cluster.
APP_DOMAIN="trackr.localhost"
APP_SCHEME="http"

# Auth. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Root superadmin, created on first run.
ROOT_EMAIL="root@example.com"
ROOT_PASSWORD=""
ROOT_NAME="Root"

# Email (sent by the worker). Empty SMTP_HOST logs mail instead of sending.
# Dev inbox: `bun run mail:start`, then SMTP_HOST=localhost SMTP_PORT=1025.
EMAIL_FROM="Trackr <no-reply@example.com>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# Native push (optional). All four APNS_* values or push jobs are skipped.
# PUSH_ENABLED="true"
# APNS_KEY=""            # .p8 PEM content
# APNS_KEY_ID=""
# APNS_TEAM_ID=""
# APNS_BUNDLE_ID=""
# APNS_ENV="production"  # development = APNs sandbox

