# Postgres. The app, migrate script, seed script, and drizzle-kit all build
# their connection URL from these vars (see src/lib/server/db/resolve-url.ts).
# docker-compose.yaml also reads them to provision the `db` service.
POSTGRES_USER="app"
POSTGRES_PASSWORD="changeme"
POSTGRES_DB="trackr"
# Host the app dials. Defaults to localhost; docker-compose.yaml overrides
# this to `db` inside the app container.
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"

# Optional. Set this to override POSTGRES_* — handy when the database lives
# elsewhere (managed provider, separate server, …). When set, the POSTGRES_*
# values above are ignored by the app/scripts (Compose still uses them to
# provision the local `db` service if you bring it up).
# DATABASE_URL="postgres://user:pass@host:5432/db"

# The app listens on container port 3000 (set in the Dockerfile). The reverse
# proxy in front (Traefik/Caddy/nginx) routes to it over the Docker network —
# no host port is published. Configure the public URL in your platform's UI.
#
# ORIGIN must stay UNSET for host-based routing to work. adapter-node uses
# `base: origin || get_origin(req.headers)` — when ORIGIN is set it pins
# every request's url.hostname to that value and ignores x-forwarded-host
# entirely. With ORIGIN unset the URL is built from PROTOCOL_HEADER /
# HOST_HEADER below. Only set ORIGIN for a single-host deploy that does NOT
# need host routing.
# ORIGIN="https://trackr.example.com"

# Reverse-proxy header configuration. Defaults match standard proxies (Traefik,
# nginx, Caddy, k8s ingress, Cloudflare, etc) and shouldn't need changing.
# Override only for atypical setups:
#   - Direct exposure with no proxy and multiple domains → HOST_HEADER=host
#     (warning: client-controlled, can be spoofed)
#   - Chained proxies, e.g. Cloudflare → Traefik → app          → XFF_DEPTH=2
#   - Custom load balancer with non-standard header names       → rename
# PROTOCOL_HEADER="x-forwarded-proto"
# HOST_HEADER="x-forwarded-host"
# XFF_DEPTH="1"

# Better Auth
# Required. 32+ chars, high entropy.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Root admin seed — consumed by `bun run seed:root` to create or promote the
# initial superadmin and link them to the internal Trackr organization.
# Required only on first run after wiping the DB.
ROOT_EMAIL="root@example.com"
ROOT_PASSWORD=""
ROOT_NAME="Root"

# Email
# Leave SMTP_HOST empty during development to log emails to the console.
# When SMTP_HOST is set, emails are sent via SMTP — misconfiguration will
# surface as an error the first time an email is sent.
EMAIL_FROM="Trackr <no-reply@example.com>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE=""  # "true" forces TLS, defaults to true when SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""
