# Canonical environment for the whole monorepo. Copy to `.env` and adjust.
#
# Consumed by:
#   - docker compose (docker-compose*.yaml read it natively)
#   - the SvelteKit dev server (web/vite.config.ts sets envDir to the repo root)
#   - standalone scripts (web/scripts/load-root-env.ts: migrate, seed, drizzle.config)
#   - the Go services (worker/scheduler load it via godotenv during host dev)

# ---------------------------------------------------------------------------
# Database.
#
# Dev: `bun run db:start` (from web/) runs ONE shared Postgres container
# (`dev-postgres`, port 5432) for every project on this machine and creates
# this project's database inside it — named after web/package.json `name`
# ("trackr"). DATABASE_URL must point at a database of that same name.
DATABASE_URL="postgres://dev:dev@localhost:5432/trackr"
#
# Prod: leave DATABASE_URL empty and the app builds its URL from the POSTGRES_*
# vars below (see web/src/lib/server/db/resolve-url.ts). docker-compose.yaml
# reads them to provision the `db` service and points the app at host `db`.
POSTGRES_USER="app"
POSTGRES_PASSWORD="changeme"
POSTGRES_DB="trackr"
# Host the app dials. Defaults to localhost; docker-compose.yaml overrides this
# to `db` inside the app container.
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"

# ---------------------------------------------------------------------------
# Public URL / host-based routing.
#
# The app listens on container port 3000 (set in the Dockerfile). The reverse
# proxy in front (Traefik/Caddy/nginx) routes to it over the Docker network —
# no host port is published. Configure the public URL in your platform's UI.
#
# ORIGIN must stay UNSET for host-based routing to work. adapter-node uses
# `base: origin || get_origin(req.headers)` — when ORIGIN is set it pins every
# request's url.hostname to that value and ignores x-forwarded-host entirely.
# With ORIGIN unset the URL is built from PROTOCOL_HEADER / HOST_HEADER below.
# Only set ORIGIN for a single-host deploy that does NOT need host routing.
# ORIGIN="https://trackr.example.com"

# Reverse-proxy header configuration. Defaults match standard proxies (Traefik,
# nginx, Caddy, k8s ingress, Cloudflare, etc) and shouldn't need changing.
# Override only for atypical setups:
#   - Direct exposure with no proxy and multiple domains → HOST_HEADER=host
#     (warning: client-controlled, can be spoofed)
#   - Chained proxies, e.g. Cloudflare → Traefik → app    → XFF_DEPTH=2
# PROTOCOL_HEADER="x-forwarded-proto"
# HOST_HEADER="x-forwarded-host"
# XFF_DEPTH="1"

# ---------------------------------------------------------------------------
# Better Auth. Required. 32+ chars, high entropy.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Root admin seed — consumed by `bun run seed:root` (runs on container start) to
# create or promote the initial superadmin and link them to the internal Trackr
# organization. Required only on first run after wiping the DB.
ROOT_EMAIL="root@example.com"
ROOT_PASSWORD=""
ROOT_NAME="Root"

# ---------------------------------------------------------------------------
# Email.
#
# Leave SMTP_HOST empty during development to log emails to the console. For a
# clickable dev inbox, run `bun run mail:start` (from web/) — it starts the
# shared Mailpit container (web UI: http://localhost:8025) — then point at it:
#   SMTP_HOST="localhost"
#   SMTP_PORT="1025"
EMAIL_FROM="Trackr <no-reply@example.com>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE=""  # "true" forces TLS; defaults to true when SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""

# ---------------------------------------------------------------------------
# File storage (web/src/lib/server/storage).
#   "local" — on-disk under STORAGE_LOCAL_DIR (Docker: a persistent volume at
#             /app/data/attachments). Zero-dependency default.
#   "s3"    — any S3-compatible endpoint. Dev uses the shared MinIO container
#             (`bun run s3:start`); prod uses AWS S3, Cloudflare R2, Supabase
#             Storage, etc.
#
# Dev MinIO: `bun run s3:start` runs ONE shared MinIO container (`dev-minio`,
# port 9000, console 9001) for every project and creates this project's bucket —
# named after web/package.json `name`. S3_BUCKET must match it.
STORAGE_DRIVER="s3"
STORAGE_LOCAL_DIR="data/attachments"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="trackr"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
# Path-style URLs; defaults to true whenever S3_ENDPOINT is set.
# S3_FORCE_PATH_STYLE="true"

# Max request body size accepted by adapter-node. Defaults to 512K, far below
# the 25 MB per-file upload cap — uploads fail before reaching the handler
# unless this is raised. Keep it above MAX_UPLOAD_BYTES × the max files staged
# in one create (see web/src/lib/attachments/config.ts).
BODY_SIZE_LIMIT="100M"

# ---------------------------------------------------------------------------
# Go services — the worker (services/worker) drains the Postgres `jobs` queue;
# the scheduler (services/scheduler) enqueues jobs for due rows in `schedules`.
# Both connect to the same Postgres as web (DATABASE_URL / POSTGRES_* above).
# In docker-compose.dev.yaml they override the host to host.docker.internal to
# reach the shared dev-postgres container.

# Worker.
WORKER_CONCURRENCY="4"
# Per-job handler timeout. Must be SHORTER than WORKER_REAP_AFTER so a job that
# is still running isn't re-queued by the reaper.
WORKER_JOB_TIMEOUT="4m"
# How long a slot waits after an empty queue before polling again. With
# WORKER_NOTIFY on this is the fallback — a LISTEN/NOTIFY signal wakes a slot
# sooner; the poll still catches delayed/retry jobs coming due.
WORKER_POLL_INTERVAL="1s"
# Instant pickup via Postgres LISTEN/NOTIFY. Set "false" behind a transaction-
# mode connection pooler (PgBouncer/Supabase transaction mode), which drops
# LISTEN/NOTIFY — pickup latency then falls back to WORKER_POLL_INTERVAL.
# Requires the notify trigger installed by `bun run db:migrate`.
WORKER_NOTIFY="true"
# How often a running job refreshes its heartbeat. Must be SHORTER than
# WORKER_REAP_AFTER. Also the cancellation-observation interval.
WORKER_HEARTBEAT="30s"
# A running job whose heartbeat is older than this is re-queued (its worker is
# presumed dead). Must EXCEED WORKER_JOB_TIMEOUT and WORKER_HEARTBEAT.
WORKER_REAP_AFTER="5m"
# Retry backoff: scheduled_at = now() + min(BASE * 2^(attempt-1), CAP).
WORKER_BACKOFF_BASE="10s"
WORKER_BACKOFF_CAP="10m"
# Restrict this worker to a comma-separated subset of job types (empty = all).
WORKER_JOB_TYPES=""
# WORKER_ID=""  # identifies this process in logs; defaults to the hostname

# Scheduler.
SCHEDULER_POLL_INTERVAL="5s"
SCHEDULER_BATCH_SIZE="100"
# SCHEDULER_ID=""  # identifies this process in logs; defaults to the hostname

# --- Outbound webhooks (admin → Settings → Webhooks) -------------------------
# Kill switch for event emission in the web app (default on).
WEBHOOKS_ENABLED="true"
# Per-attempt HTTP timeout in the worker.
WEBHOOK_TIMEOUT="10s"
# Destinations must be https on a public address. Set to true ONLY for local
# development against a receiver on localhost/LAN — read by web AND worker.
WEBHOOK_ALLOW_PRIVATE_URLS="false"
