# Drizzle
DATABASE_URL="postgres://root:mysecretpassword@localhost:5432/local"

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Root user — consumed by `bun run seed:root` to create or promote the
# initial superadmin and link them to the internal Trackr organization.
# Required only on first run after wiping the DB.
ROOT_EMAIL=""
ROOT_PASSWORD=""
ROOT_NAME="Root"
