{
	"name": "trackr",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && bun scripts/build-server.ts",
		"start": "bun build/server-entry.js",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"db:start": "docker compose up db",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"migrate": "bun scripts/migrate.ts",
		"auth:schema": "better-auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes",
		"seed:root": "bun run scripts/seed-root.ts",
		"seed:demo": "bun run scripts/seed-demo.ts"
	},
	"devDependencies": {
		"@better-auth/cli": "~1.4.21",
		"@eslint/compat": "^2.0.4",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.2",
		"@types/jsdom": "^28.0.3",
		"@types/node": "^24",
		"@types/nodemailer": "^8.0.0",
		"@types/pdfmake": "^0.3.3",
		"@types/ws": "^8.18.1",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^17.4.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^4.2.2",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.1",
		"vite": "^8.0.7"
	},
	"dependencies": {
		"@hocuspocus/extension-database": "^4.1.0",
		"@hocuspocus/provider": "^4.1.0",
		"@hocuspocus/server": "^4.1.0",
		"@hocuspocus/transformer": "^4.1.0",
		"@lucide/svelte": "^1.14.0",
		"@sveltejs/kit": "^2.57.0",
		"@tiptap/core": "^3.23.4",
		"@tiptap/extension-collaboration": "^3.23.4",
		"@tiptap/extension-collaboration-caret": "^3.23.6",
		"@tiptap/extension-image": "^3.23.4",
		"@tiptap/extension-link": "^3.23.4",
		"@tiptap/extension-placeholder": "^3.23.4",
		"@tiptap/extension-task-item": "^3.23.4",
		"@tiptap/extension-task-list": "^3.23.4",
		"@tiptap/html": "^3.23.4",
		"@tiptap/starter-kit": "^3.23.4",
		"@tiptap/suggestion": "^3.23.4",
		"better-auth": "~1.4.21",
		"drizzle-orm": "^0.45.2",
		"jsdom": "^29.1.1",
		"nodemailer": "^8.0.7",
		"pdfmake": "^0.3.9",
		"postgres": "^3.4.9",
		"sharp": "^0.34.5",
		"svelte": "^5.55.2",
		"thumbhash": "^0.1.1",
		"ws": "^8.21.0",
		"yjs": "^13"
	}
}
