{
	"name": "trackr",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && bun scripts/build-server.ts",
		"start": "bun build/server-entry.js",
		"preview": "vite preview",
		"paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
		"prepare": "svelte-kit sync && (paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide || echo '')",
		"check": "svelte-kit sync && bun run paraglide && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && bun run paraglide && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"db:start": "bun run scripts/db/start.ts",
		"s3:start": "bun run scripts/storage/start.ts",
		"mail:start": "bun run scripts/mail/start.ts",
		"services:start": "docker compose -f ../docker-compose.dev.yaml up -d --build",
		"services:stop": "docker compose -f ../docker-compose.dev.yaml down",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "bun run scripts/db/migrate.ts",
		"db:studio": "drizzle-kit studio",
		"auth:schema": "better-auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes",
		"seed:root": "bun run scripts/db/seed-root.ts",
		"seed:demo": "bun run scripts/db/seed-demo.ts"
	},
	"devDependencies": {
		"@better-auth/cli": "~1.4.21",
		"@eslint/compat": "^2.0.4",
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.18.2",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.2",
		"@types/jsdom": "^28.0.3",
		"@types/node": "^24",
		"@types/pdfmake": "^0.3.3",
		"@types/ws": "^8.18.1",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^17.4.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^4.2.2",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.1",
		"vite": "^8.0.7"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.700.0",
		"@hocuspocus/extension-database": "^4.1.0",
		"@hocuspocus/provider": "^4.1.0",
		"@hocuspocus/server": "^4.1.0",
		"@hocuspocus/transformer": "^4.1.0",
		"@lucide/svelte": "^1.14.0",
		"@sveltejs/kit": "^2.57.0",
		"@tiptap/core": "^3.23.4",
		"@tiptap/extension-collaboration": "^3.23.4",
		"@tiptap/extension-collaboration-caret": "^3.23.6",
		"@tiptap/extension-image": "^3.23.4",
		"@tiptap/extension-link": "^3.23.4",
		"@tiptap/extension-placeholder": "^3.23.4",
		"@tiptap/extension-task-item": "^3.23.4",
		"@tiptap/extension-task-list": "^3.23.4",
		"@tiptap/html": "^3.23.4",
		"@tiptap/starter-kit": "^3.23.4",
		"@tiptap/suggestion": "^3.23.4",
		"better-auth": "~1.4.21",
		"drizzle-orm": "^0.45.2",
		"jsdom": "^29.1.1",
		"marked": "^18.0.5",
		"pdfmake": "^0.3.9",
		"postgres": "^3.4.9",
		"sharp": "^0.34.5",
		"svelte": "^5.55.2",
		"thumbhash": "^0.1.1",
		"ws": "^8.21.0",
		"yjs": "^13"
	}
}
