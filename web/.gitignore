# SvelteKit / web-app specific ignores. General ignores (env, OS, Go) live in
# the repo-root .gitignore. This file existing matters: eslint.config.js and
# prettier both run from web/ and read it to skip generated output.

node_modules

# Output
.output
.vercel
.netlify
.wrangler
.svelte-kit
build
dist

# MCP App widgets (built by `bun run mcp:ui`, inlined into the server)
src/lib/server/mcp/ui/dist

# Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Paraglide (generated by the Vite plugin)
src/lib/paraglide
project.inlang/cache/

# Local file storage (storage driver "local")
data/
