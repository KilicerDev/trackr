# Repo-root, general ignores shared across the monorepo. SvelteKit/web-specific
# ignores (node_modules, .svelte-kit, build, paraglide, …) live in web/.gitignore.

# OS
.DS_Store
Thumbs.db

# Env (canonical .env lives at the repo root)
.env
.env.*
!.env.example
!.env.test

# Go build artifacts
*.exe
services/*/bin/
